{
  "name": "IDG · Gestão de Atividades e Férias · Contrato AMP",
  "short_name": "IDG AMP",
  "description": "Gestão de atividades, mapa de carga e férias da equipe IDG Engenharia no contrato ArcelorMittal Pecém.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#1B2A5C",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Atividades", "url": "./#/atividades", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Férias", "url": "./#/ferias", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
